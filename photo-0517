        </header>

        <!-- Filters -->
        <div class="glass-card rounded-2xl p-6 mb-8 shadow-sm flex flex-wrap gap-4 items-end">
            <div class="flex-1 min-w-[150px]">
                <label class="block text-sm font-medium text-slate-600 mb-2">地區</label>
                <select id="regionFilter" class="w-full bg-white border border-slate-200 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none transition-all">
                    <option value="all">所有地區</option>
                </select>
            </div>
            <div class="flex-1 min-w-[150px]">
                <label class="block text-sm font-medium text-slate-600 mb-2">國家/城市</label>
                <select id="countryFilter" class="w-full bg-white border border-slate-200 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none transition-all">
                    <option value="all">所有地點</option>
                </select>
            </div>
            <button id="resetBtn" class="px-6 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg font-medium transition-colors">
                重設
            </button>
        </div>

        <!-- Stats -->
        <div id="stats" class="mb-4 text-sm text-slate-500 font-medium"></div>

        <!-- Results Grid -->
        <div id="gallery" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <!-- Cards will be injected here -->
        </div>

        <!-- Pagination -->
        <div id="pagination" class="mt-12 flex justify-center items-center gap-2">
            <!-- Pagination buttons will be injected here -->
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden py-20 text-center">
            <p class="text-slate-400 text-lg">找不到符合條件的照片</p>
        </div>
    </div>

