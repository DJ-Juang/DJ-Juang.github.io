<body class="p-4 md:p-8">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <header class="mb-8 flex items-center justify-center gap-6">
            <img src="https://lh3.googleusercontent.com/d/1IUW5Uq5M8pgTfMX6zE58J7gUcs1Wo6fo" alt="Left Icon" class="w-12 h-12 rounded-full shadow-sm object-cover">
